{
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "2 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "customDatasources": {
    "mysql-lts": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/docker-library/official-images/master/library/mysql",
      "format": "plain",
      "transformTemplates": [
        "( $ltsLine := releases.version[$substring($, 0, 6) = 'Tags: ' and $contains(', ' & $substringAfter($, 'Tags: ') & ', ', ', lts, ')][0]; $minor := $split($substringAfter($ltsLine, 'Tags: '), ', ')[$match($, /^\\d+\\.\\d+$/)][0]; { 'releases': $minor ? [{ 'version': $minor }] : [] } )"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/provisioning/image/ansible/04_xbuild.yml/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\n.*?-install v?(?<currentValue>[0-9.]*).*\n"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/provisioning/bench/ansible/02_golang.yml/"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "matchStrings": [
        "go(?<currentValue>[0-9]*.[0-9]*.[0-9]*)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.github/workflows/codeql.yml/"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "matchStrings": [
        "go-version: \"?(?<currentValue>[0-9]*.[0-9]*.[0-9]*)\"?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/osv-scanner.toml/"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "matchStrings": [
        "GoVersionOverride = \"?(?<currentValue>[0-9]*.[0-9]*.[0-9]*)\"?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^webapp\\/compose\\.yml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]+mysql:[ \\t]*\\r?\\n[ \\t]+image:[ \\t]*mysql:(?<currentValue>\\d+\\.\\d+)[ \\t]*(?:#.*)?(?:\\r?\\n|$)"
      ],
      "depNameTemplate": "mysql",
      "datasourceTemplate": "custom.mysql-lts",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": [
        "Keep lock file maintenance PRs split by application."
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "webapp/ruby/Gemfile",
        "webapp/ruby/Gemfile.lock"
      ],
      "branchTopic": "ruby-lock-file-maintenance",
      "commitMessageTopic": "Ruby lock file"
    },
    {
      "description": [
        "Keep lock file maintenance PRs split by application."
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "webapp/php/composer.json",
        "webapp/php/composer.lock"
      ],
      "branchTopic": "php-lock-file-maintenance",
      "commitMessageTopic": "PHP lock file"
    },
    {
      "description": [
        "Keep lock file maintenance PRs split by application."
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "webapp/node/package.json",
        "webapp/node/package-lock.json"
      ],
      "branchTopic": "node-lock-file-maintenance",
      "commitMessageTopic": "Node lock file"
    },
    {
      "description": [
        "Keep lock file maintenance PRs split by application."
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchFileNames": [
        "webapp/python/pyproject.toml",
        "webapp/python/uv.lock"
      ],
      "branchTopic": "python-lock-file-maintenance",
      "commitMessageTopic": "Python lock file"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "nginx"
      ],
      "versioning": "regex:^(?<major>[0-9]+)\\.(?<minor>[0-9]*[02468])(?<patch>\\d*)$"
    },
    {
      "description": [
        "Let the custom datasource manage the MySQL LTS version in Docker Compose."
      ],
      "matchManagers": [
        "docker-compose"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mysql"
      ],
      "matchFileNames": [
        "webapp/compose.yml"
      ],
      "enabled": false
    },
    {
      "description": [
        "The MySQL LTS custom datasource does not provide release timestamps, so override the global minimumReleaseAge; otherwise Renovate treats its updates as permanently pending."
      ],
      "matchDatasources": [
        "custom.mysql-lts"
      ],
      "matchPackageNames": [
        "mysql"
      ],
      "matchFileNames": [
        "webapp/compose.yml"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": [
        "bundler"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "matchManagers": [
        "composer"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "rangeStrategy": "bump"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ]
}
