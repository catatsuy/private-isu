vendor/
portal/log
portal/tmp

### Portal
# Ignore bundler config.
/portal/.bundle
/portal/vendor/bundle

# Ignore the default SQLite database.
/portal/db/*.sqlite3
/portal/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/portal/log/*
!/portal/log/.keep
/portal/tmp
.vagrant

# .claude 配下は skills だけ git 管理下に置く。
# ディレクトリ自体を無視すると git が中に降りず否定パターンが効かないため、
# `.claude/` ではなく `.claude/*` と書くこと。
.claude/*
!.claude/skills/
